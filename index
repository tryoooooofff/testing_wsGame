const { WebSocketServer } = require('ws');
const http = require('http');
const fs = require('fs');
const path = require('path');

const PORT = process.env.PORT || 3000;
const TICK_RATE = 60;           // 游戏逻辑帧率
const BROADCAST_EVERY = 3;      // 每3帧广播一次
const ARENA_W = 800;
const ARENA_H = 600;
const PLAYER_SPEED = 3;
const BULLET_SPEED = 7;
const PLAYER_SIZE = 20;
const BULLET_SIZE = 5;
const MAX_PLAYERS = 8;
const RESPAWN_TIME = 180;       // 帧数

// ── HTTP 服务（静态文件）──────────────────────────────────────────
const server = http.createServer((req, res) => {
  let filePath = path.join(__dirname, '../public', req.url === '/' ? 'index.html' : req.url);
  const ext = path.extname(filePath);
  const mime = { '.html': 'text/html', '.js': 'application/javascript', '.css': 'text/css' };
  fs.readFile(filePath, (err, data) => {
    if (err) { res.writeHead(404); res.end('Not found'); return; }
    res.writeHead(200, { 'Content-Type': mime[ext] || 'text/plain' });
    res.end(data);
  });
});

// ── 游戏状态 ──────────────────────────────────────────────────────
const players = new Map();   // id → player
const bullets = new Map();   // id → bullet
const pickups = new Map();   // id → pickup
let nextId = 1;
let tick = 0;

function randomColor() {
  const colors = [0xFF4444, 0x44AAFF, 0x44FF88, 0xFFAA00, 0xFF44FF, 0x00FFFF, 0xFFFF44, 0xFF8844];
  return colors[Math.floor(Math.random() * colors.length)];
}

function spawnPickup() {
  if (pickups.size >= 10) return;
  const id = nextId++;
  pickups.set(id, {
    id,
    x: 40 + Math.random() * (ARENA_W - 80),
    y: 40 + Math.random() * (ARENA_H - 80),
    type: Math.random() < 0.5 ? 0 : 1  // 0=ammo 1=shield
  });
}

function createPlayer(ws, name) {
  const id = nextId++;
  const player = {
    id,
    ws,
    name: name.slice(0, 12),
    x: 100 + Math.random() * (ARENA_W - 200),
    y: 100 + Math.random() * (ARENA_H - 200),
    vx: 0, vy: 0,
    angle: 0,
    hp: 100,
    score: 0,
    ammo: 30,
    shield: 0,
    dead: false,
    respawnTimer: 0,
    color: randomColor(),
    // 输入缓冲
    input: { keys: 0, angle: 0, fire: false },
    lastX: 0, lastY: 0, dirty: true
  };
  players.set(id, player);
  return player;
}

// ── 游戏逻辑 ──────────────────────────────────────────────────────
function processInput(p) {
  if (p.dead) return;
  const keys = p.input.keys;
  const speed = PLAYER_SPEED;
  p.vx = 0; p.vy = 0;
  if (keys & 1) p.vy = -speed;  // W / up
  if (keys & 2) p.vy =  speed;  // S / down
  if (keys & 4) p.vx = -speed;  // A / left
  if (keys & 8) p.vx =  speed;  // D / right
  // 斜向归一化
  if (p.vx !== 0 && p.vy !== 0) { p.vx *= 0.707; p.vy *= 0.707; }
  p.angle = p.input.angle;
  // 移动
  p.x = Math.max(PLAYER_SIZE, Math.min(ARENA_W - PLAYER_SIZE, p.x + p.vx));
  p.y = Math.max(PLAYER_SIZE, Math.min(ARENA_H - PLAYER_SIZE, p.y + p.vy));
  // 开火
  if (p.input.fire && p.ammo > 0 && tick % 10 === 0) {
    p.ammo--;
    const id = nextId++;
    bullets.set(id, {
      id, ownerId: p.id,
      x: p.x, y: p.y,
      vx: Math.cos(p.angle) * BULLET_SPEED,
      vy: Math.sin(p.angle) * BULLET_SPEED,
      life: 80
    });
  }
}

function updateBullets() {
  for (const [id, b] of bullets) {
    b.x += b.vx; b.y += b.vy; b.life--;
    if (b.life <= 0 || b.x < 0 || b.x > ARENA_W || b.y < 0 || b.y > ARENA_H) {
      bullets.delete(id); continue;
    }
    // 碰撞检测
    for (const [pid, p] of players) {
      if (pid === b.ownerId || p.dead) continue;
      const dx = p.x - b.x, dy = p.y - b.y;
      if (dx * dx + dy * dy < (PLAYER_SIZE + BULLET_SIZE) ** 2) {
        const dmg = p.shield > 0 ? 5 : 20;
        p.hp -= dmg;
        if (p.shield > 0) p.shield -= 30;
        bullets.delete(id);
        if (p.hp <= 0) {
          p.hp = 0; p.dead = true; p.respawnTimer = RESPAWN_TIME;
          const killer = players.get(b.ownerId);
          if (killer) { killer.score++; killer.dirty = true; }
          p.dirty = true;
        }
        break;
      }
    }
  }
}

function updatePickups() {
  for (const [id, pk] of pickups) {
    for (const [, p] of players) {
      if (p.dead) continue;
      const dx = p.x - pk.x, dy = p.y - pk.y;
      if (dx * dx + dy * dy < (PLAYER_SIZE + 8) ** 2) {
        if (pk.type === 0) p.ammo = Math.min(p.ammo + 15, 60);
        else p.shield = Math.min(p.shield + 100, 200);
        pickups.delete(id);
        p.dirty = true;
        break;
      }
    }
  }
  if (Math.random() < 0.01) spawnPickup();
}

function updateRespawns() {
  for (const [, p] of players) {
    if (p.dead && p.respawnTimer-- <= 0) {
      p.dead = false; p.hp = 100; p.ammo = 30; p.shield = 0;
      p.x = 100 + Math.random() * (ARENA_W - 200);
      p.y = 100 + Math.random() * (ARENA_H - 200);
      p.dirty = true;
    }
  }
}

// ── 二进制序列化 ──────────────────────────────────────────────────
// 协议：
// [1] type
// 玩家 entry: id(u16) x(i16) y(i16) angle(i16×100) hp(u8) shield(u8) ammo(u8) score(u16) color(u32) flags(u8) nameLen(u8) name(utf8)
// 子弹 entry: id(u16) x(i16) y(i16)
// 拾取 entry: id(u16) x(i16) y(i16) type(u8)

function buildStatePacket() {
  const playerArr = [...players.values()];
  const bulletArr = [...bullets.values()];
  const pickupArr = [...pickups.values()];

  // 估算大小
  const playerBytes = playerArr.reduce((s, p) => s + 17 + p.name.length, 0);
  const bulletBytes = bulletArr.length * 6;
  const pickupBytes = pickupArr.length * 7;
  const total = 1 + 2 + playerBytes + 2 + bulletBytes + 2 + pickupBytes;

  const buf = Buffer.allocUnsafe(total);
  let o = 0;
  buf[o++] = 1; // type: full state

  // 玩家
  buf.writeUInt16LE(playerArr.length, o); o += 2;
  for (const p of playerArr) {
    buf.writeUInt16LE(p.id, o); o += 2;
    buf.writeInt16LE(Math.round(p.x), o); o += 2;
    buf.writeInt16LE(Math.round(p.y), o); o += 2;
    buf.writeInt16LE(Math.round(p.angle * 100), o); o += 2;
    buf[o++] = p.hp;
    buf[o++] = Math.min(p.shield, 255);
    buf[o++] = p.ammo;
    buf.writeUInt16LE(p.score, o); o += 2;
    buf.writeUInt32LE(p.color, o); o += 4;
    buf[o++] = (p.dead ? 1 : 0);
    const nb = Buffer.from(p.name, 'utf8').slice(0, 12);
    buf[o++] = nb.length;
    nb.copy(buf, o); o += nb.length;
  }

  // 子弹
  buf.writeUInt16LE(bulletArr.length, o); o += 2;
  for (const b of bulletArr) {
    buf.writeUInt16LE(b.id, o); o += 2;
    buf.writeInt16LE(Math.round(b.x), o); o += 2;
    buf.writeInt16LE(Math.round(b.y), o); o += 2;
  }

  // 拾取物
  buf.writeUInt16LE(pickupArr.length, o); o += 2;
  for (const pk of pickupArr) {
    buf.writeUInt16LE(pk.id, o); o += 2;
    buf.writeInt16LE(Math.round(pk.x), o); o += 2;
    buf.writeInt16LE(Math.round(pk.y), o); o += 2;
    buf[o++] = pk.type;
  }

  return buf.slice(0, o);
}

function buildWelcomePacket(playerId) {
  const buf = Buffer.allocUnsafe(3);
  buf[0] = 0; // type: welcome
  buf.writeUInt16LE(playerId, 1);
  return buf;
}

// ── 主循环 ──────────────────────────────────────────────────────
function gameTick() {
  tick++;
  for (const [, p] of players) processInput(p);
  updateBullets();
  updatePickups();
  updateRespawns();

  if (tick % BROADCAST_EVERY === 0 && players.size > 0) {
    const packet = buildStatePacket();
    for (const [, p] of players) {
      if (p.ws.readyState === 1) p.ws.send(packet);
    }
  }
}

setInterval(gameTick, 1000 / TICK_RATE);
// 初始拾取物
for (let i = 0; i < 5; i++) spawnPickup();

// ── WebSocket 服务 ─────────────────────────────────────────────
const wss = new WebSocketServer({ server });

wss.on('connection', (ws) => {
  if (players.size >= MAX_PLAYERS) { ws.close(1008, 'full'); return; }

  let player = null;

  ws.on('message', (data, isBinary) => {
    if (isBinary && data.length >= 1) {
      const type = data[0];

      if (type === 0 && !player) {
        // 加入游戏：type(1) nameLen(1) name
        const nameLen = Math.min(data[1] || 6, 12);
        const name = data.slice(2, 2 + nameLen).toString('utf8') || 'Player';
        player = createPlayer(ws, name);
        ws.send(buildWelcomePacket(player.id));
        console.log(`[+] ${player.name} #${player.id} joined (${players.size} online)`);
        return;
      }

      if (type === 1 && player) {
        // 输入：type(1) keys(1) angleLo(1) angleHi(1) fire(1)
        if (data.length < 5) return;
        player.input.keys = data[1];
        const angleRaw = data.readInt16LE(2);
        player.input.angle = angleRaw / 100;
        player.input.fire = data[4] !== 0;
      }
    }
  });

  ws.on('close', () => {
    if (player) {
      console.log(`[-] ${player.name} #${player.id} left`);
      players.delete(player.id);
    }
  });

  ws.on('error', () => ws.terminate());
});

server.listen(PORT, () => console.log(`Game server running on port ${PORT}`));
